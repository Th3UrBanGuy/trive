# TriVE Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file — it contains secrets.

# SQLite database path
DATABASE_URL=file:./db/custom.db

# Telegram MTProto credentials — get these from https://my.telegram.org → API development tools
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Telegram Bot Credentials (SSO + Storage Engine) — get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username
NEXT_PUBLIC_BOT_USERNAME=your_bot_username

# Optional: Dedicated storage channel ID (e.g. -1001234567890).
# If left empty, files are saved directly in the bot's direct private chat inbox with the user!
TELEGRAM_STORAGE_CHAT_ID=

# App encryption pepper for session strings — generate a random string for production
APP_SECRET=generate-a-random-secret-here

# Admin panel password — the hidden admin panel is at /?admin=1
ADMIN_PASSWORD=change-this-admin-password

# Public app name
NEXT_PUBLIC_APP_NAME=TriVE

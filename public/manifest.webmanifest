{
  "name": "TriVE — Secure File Management",
  "short_name": "TriVE",
  "description": "Zero-knowledge cloud storage powered by your Telegram account. End-to-end encrypted, unlimited, and private.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ebeff2",
  "theme_color": "#ebeff2",
  "categories": ["productivity", "utilities", "security"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "/favicon.ico", "sizes": "16x16 32x32 48x48", "type": "image/x-icon" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "shortcuts": [
    {
      "name": "My Files",
      "short_name": "Files",
      "description": "View your encrypted files",
      "url": "/?view=files"
    },
    {
      "name": "Upload",
      "short_name": "Upload",
      "description": "Upload a file to your vault",
      "url": "/?action=upload"
    }
  ],
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"]
}
